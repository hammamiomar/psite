---
import CvVisionPortal from '@/components/CvVisionPortal.astro'
import PageHead from '@/components/PageHead.astro'
import WorkTimer from '@/components/ui/work-timer'
import Layout from '@/layouts/Layout.astro'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Omar Hammami',
  url: 'https://hammamiomar.com',
  email: 'mailto:hhammamiomar@gmail.com',
  jobTitle: 'Applied ML Researcher & Systems Engineer',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'New York University',
  },
  sameAs: [
    'https://computervision.vision',
    'https://dinodreamer.computervision.vision',
    'https://github.com/hammamiomar',
    'https://linkedin.com/in/hhammamiomar',
    'https://x.com/hambagugu',
  ],
}
---

<Layout flushTop={true}>
  <PageHead slot="head" title="Omar Hammami" />
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />

  <CvVisionPortal />

  <WorkTimer client:load className="py-12" />
</Layout>
