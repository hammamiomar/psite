---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'

interface Props {
  flushTop?: boolean
}

const { flushTop = false } = Astro.props
---

<!doctype html>
<html
  data-theme="dark"
  class="bg-background text-foreground scheme-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="overflow-x-hidden">
    <div
      class:list={[
        'flex h-fit min-h-screen flex-col font-sans',
        flushTop ? 'gap-y-0' : 'gap-y-8',
      ]}
    >
      <div
        class:list={[
          'z-50 divide-y xl:divide-none',
          flushTop
            ? 'bg-background'
            : 'bg-background/90 sticky top-0 backdrop-blur-sm',
        ]}
      >
        <Header />
        <slot name="subposts-navigation" />
        <slot name="table-of-contents" />
      </div>
      <main class="grow">
        <div
          class:list={[
            'mx-auto flex max-w-3xl grow flex-col px-4',
            flushTop ? 'gap-y-0' : 'gap-y-6',
          ]}
        >
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
