---
import { readFileSync } from 'node:fs'
import { publicDir } from 'astro:config/server'
import { FIGURE_PYRAMID_LAYOUT } from '@/lib/portal-nca/material-file'
import { DEFAULT_STEPS_UNDER_A_RULE } from '@/lib/portal-nca/opening-automaton-rules'
import type { PortalRuleChoice } from '@/lib/portal-nca/portal-sliver'

interface MaterialFields {
  block: number
  rule: { layout: string }
  reading: { tick?: number }
}

const PORTAL_AUTOMATA: string[] = [
  '2801-plain-all-noise-seed-0',
  '2088-guided-all-noise-seed-0',
  '16250-guided-release-floor-1-all-noise-seed-1',
  'block-13345-stage-6-pyramid-strongest-seed-1',
  '12002-given-set-pole-3x3-noise-projection-mmd-layers-final-seed-0',
  '6448-given-set-t13-companions-pole-3x3-noise-plain-seed-1',
]

const rules: PortalRuleChoice[] = PORTAL_AUTOMATA.map((id) => {
  const fileUrl = new URL(`portal-automata/${id}.material.json`, publicDir)
  const material = JSON.parse(readFileSync(fileUrl, 'utf8')) as MaterialFields
  return {
    block: material.block,
    materialUrl: `/portal-automata/${id}.material.json`,
    stillUrl: `/portal-automata/${id}.preview.png`,
    steps: material.reading.tick ?? DEFAULT_STEPS_UNDER_A_RULE,
    twoGrids: material.rule.layout === FIGURE_PYRAMID_LAYOUT,
  }
})

const first = rules[0]
---

<section class="cv-takeover not-prose" aria-label="computervision.vision">
  <portal-nca-sliver class="cv-sliver" data-state="still">
    <script
      type="application/json"
      data-part="rules"
      set:html={JSON.stringify(rules)}
    />
    <div
      class="cv-sliver-field"
      data-part="field"
      role="img"
      aria-label="A live cellular automaton growing patterns learned from Meta's DINOv3. Drag across it to disturb the cells."
    >
      <div
        class="cv-sliver-still"
        data-part="still"
        style={`background-image: url(${first.stillUrl})`}
      >
      </div>
      <canvas data-part="canvas" data-shown></canvas>
      <canvas data-part="canvas"></canvas>
      <span class="cv-sliver-brush" data-part="brush-ring" aria-hidden="true"
      ></span>
    </div>
  </portal-nca-sliver>

  <div class="cv-body">
    <div class="cv-head">
      <h1 class="cv-wordmark">
        <a
          href="https://computervision.vision"
          target="_blank"
          rel="noopener noreferrer"
        >
          computervision.<span class="cv-nowrap"
            >vision<span class="cv-arrow" aria-hidden="true">&nbsp;↗</span></span
          >
        </a>
      </h1>
      <p class="cv-lead">
        Vision interpretability as a creative domain.
      </p>
    </div>

    <article class="cv-row" aria-labelledby="cv-dinodreamer">
      <h2 id="cv-dinodreamer">DinoDreamer</h2>
      <div class="cv-row-detail">
        <p>
          Explore DINOv3’s representations with a block-sparse featurizer and
          grow cellular automata in your browser.
        </p>
        <nav aria-label="DinoDreamer">
          <a
            href="https://computervision.vision/writing/dinodreamer/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Write-up ↗
          </a>
          <a
            href="https://dinodreamer.computervision.vision/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open DinoDreamer ↗
          </a>
          <a
            href="https://github.com/hammamiomar/dinodreamer"
            target="_blank"
            rel="noopener noreferrer"
          >
            Code ↗
          </a>
        </nav>
      </div>
    </article>

    <article class="cv-row" aria-labelledby="cv-latent-dance">
      <h2 id="cv-latent-dance">Latent Dance</h2>
      <div class="cv-row-detail">
        <p>
          Music visualization through steering 20,480 sparse autoencoder
          features live in SDXL.
        </p>
        <nav aria-label="Latent Dance">
          <a href="/blog/letting-computers-dance">Write-up ↗</a>
          <a
            href="https://github.com/hammamiomar/latent-dance"
            target="_blank"
            rel="noopener noreferrer"
          >
            Code ↗
          </a>
        </nav>
      </div>
    </article>
  </div>
</section>

<script>
  import '@/lib/portal-nca/portal-sliver'
</script>

<style>
  .cv-takeover {
    --cv-ink: #efece8;
    --cv-ink-2: #a8a39b;
    --cv-ink-3: #76716a;
    --cv-line: rgb(255 255 255 / 0.14);

    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    background: #000;
    color: var(--cv-ink);
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-sliver {
    display: block;
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-sliver-field {
    position: relative;
    height: clamp(280px, 44vh, 450px);
    overflow: hidden;
    background: #050505;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .cv-sliver-still,
  .cv-sliver-field canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    visibility: hidden;
    image-rendering: pixelated;
  }

  .cv-sliver[data-state='live'] canvas[data-shown] {
    visibility: visible;
  }

  .cv-sliver-still {
    background-size: var(--still-tile, 512px);
  }

  .cv-sliver[data-state='still'] .cv-sliver-still {
    visibility: visible;
  }

  .cv-sliver-brush {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .cv-sliver[data-state='live'] .cv-sliver-field:hover .cv-sliver-brush {
    opacity: 1;
  }

  .cv-body {
    width: min(1120px, calc(100% - 4rem));
    margin-inline: auto;
    padding-block: 3rem;
  }

  .cv-head {
    padding-bottom: 3rem;
  }

  .cv-wordmark {
    margin: 0 0 0.75rem;
    font-size: clamp(2.1rem, 6.4vw, 5rem);
    font-weight: 380;
    letter-spacing: -0.024em;
    line-height: 1.02;
  }

  .cv-nowrap {
    white-space: nowrap;
  }

  .cv-wordmark a {
    color: var(--cv-ink);
    text-decoration: none;
  }

  .cv-wordmark a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  .cv-arrow {
    font-family: var(--font-mono);
    font-size: 0.4em;
    color: var(--cv-ink-3);
    vertical-align: super;
  }

  .cv-wordmark a:hover .cv-arrow {
    color: #fff;
  }

  .cv-lead {
    margin: 0;
    font-size: clamp(1.15rem, 1.85vw, 1.5rem);
    line-height: 1.4;
    color: var(--cv-ink-2);
  }

  .cv-row {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    padding-block: 3rem;
    border-top: 1px solid var(--cv-line);
  }

  .cv-row:last-child {
    padding-bottom: 0;
  }

  .cv-row h2 {
    margin: 0;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 450;
    letter-spacing: -0.014em;
    line-height: 1.15;
    color: var(--cv-ink);
  }

  .cv-row-detail p {
    margin: 0;
    max-width: 48ch;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--cv-ink-2);
  }

  .cv-row-detail nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.2rem;
    font: 400 0.8125rem / 1.5 var(--font-mono);
  }

  .cv-row-detail nav a {
    color: var(--cv-ink);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 5px;
  }

  .cv-row-detail nav a:hover {
    color: #fff;
    text-decoration-color: #fff;
  }

  .cv-row-detail nav a.cv-primary-link {
    color: #fff;
    text-decoration-color: rgb(255 255 255 / 0.5);
  }

  @media (max-width: 720px) {
    .cv-sliver-field {
      height: clamp(220px, 36vh, 300px);
    }

    .cv-body {
      width: calc(100% - 2.5rem);
      padding-block: 2rem;
    }

    .cv-head {
      padding-bottom: 2rem;
    }

    .cv-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-block: 2rem;
    }

    .cv-row:last-child {
      padding-bottom: 0;
    }

    .cv-row-detail p {
      font-size: 1.05rem;
    }

    .cv-row-detail nav {
      margin-top: 0.95rem;
      gap: 0.5rem 1.25rem;
    }
  }
</style>
